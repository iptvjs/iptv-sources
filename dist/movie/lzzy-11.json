od_content":"本作描绘了一名医生，因一种围绕“废用身”——因瘫痪等原因已无恢复可能的四肢——的治疗方法，而一步步踏入在追求理想的理性与疯狂之间摇摆的危险领域。在某座城镇的日间照护中心里，一种突破性的疗法在老年人之间悄然流传：对患者进行废用身切除后，不仅“身体和心情都变轻松了”，甚至“原本严厉的性格也变得温和”，出现了看似积极的副作用。听闻此事的编辑矢仓察觉到其可能为老年医疗带来革命性变革，遂向开发该疗法的院长漆原提出出书邀约。然而，关于该照护中心的内部举报被泄露至周刊杂志，加之患者家中发生的一起事件，事态骤然逆转，真相逐渐陷入黑暗。                                                                      　　本片改编自久坂部羊的同名原著小说。","vod_play_from":"lzm3u8","vod_play_server":"no","vod_play_note":"","vod_play_url":"HD中字$https:\/\/v.lfthirtytwo.com\/20260805\/9254_4e1d1fd5\/index.m3u8","vod_down_from":"http","vod_down_server":"no","vod_down_note":"","vod_down_url":"HD中字$https:\/\/lzdown27.com\/20260805\/9254_4e1d1fd5\/废用身 廃用身 (2026).mp4","vod_plot":0,"vod_plot_name":"","vod_plot_detail":"","type_name":"剧情片"},{"vod_id":150221,"type_id":11,"type_id_1":1,"group_id":0,"vod_name":"让爱回家","vod_sub":"","vod_en":"rangaihuijia","vod_status":1,"vod_letter":"R","vod_color":"","vod_tag":"","vod_class":"剧情","vod_pic":"https:\/\/img.lzipic.com\/upload\/vod\/20260805-1\/fbb4f696c5f31363fbd5943da58e280b.webp","vod_pic_thumb":"","vod_pic_slide":"","vod_pic_screenshot":null,"vod_actor":"","vod_director":"","vod_writer":"","vod_behind":"","vod_blurb":"...","vod_remarks":"HD","vod_pubdate":"2026(中国大陆网络)","vod_total":0,"vod_serial":"","vod_tv":"","vod_weekday":"","vod_area":"中国大陆","vod_lang":"汉语普通话","vod_year":"2026","vod_version":"","vod_state":"","vod_author":"","vod_jumpurl":"","vod_tpl":"","vod_tpl_play":"","vod_tpl_down":"","vod_isend":0,"vod_lock":0,"vod_level":0,"vod_copyright":0,"vod_points":0,"vod_points_play":0,"vod_points_down":0,"vod_hits":0,"vod_hits_day":0,"vod_hits_week":0,"vod_hits_month":0,"vod_duration":"","vod_up":0,"vod_down":0,"vod_score":"0.0","vod_score_all":0,"vod_score_num":0,"vod_time":"2026-08-05 19:57:30","vod_time_add":1785931050,"vod_time_hits":0,"vod_time_make":0,"vod_trysee":0,"vod_douban_id":38424445,"vod_douban_score":"0.0","vod_reurl":"","vod_rel_vod":"","vod_rel_art":"","vod_pwd":"","vod_pwd_url":"","vod_pwd_play":"","vod_p