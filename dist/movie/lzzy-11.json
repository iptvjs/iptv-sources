大陆喧嚣的挪威希德拉小岛，路易丝・安德森拥有看似圆满的人生：爱人相伴，经营一间小小的咖啡馆，岁月安静流淌。可突如其来的陌生人，掷出一道足以颠覆全部自我的指控 —— 她不是路易丝，而是三年前人间蒸发的丹麦女性海伦娜・瑟德贝里。                                                                      　　那些她毫无记忆的过往被一一摆到眼前：丈夫、年幼的孩子，一段她完全不曾拥有的人生。自我认知开始崩塌，记忆支离破碎，分不清现实与虚妄。她忍痛告别眼前安稳的生活，孤身回到丹麦，试图拼凑失踪之夜的真相。然而旧友与亲人各怀心事，处处皆是隐瞒与矛盾。在北欧冷冽压抑的氛围之下，她不断叩问：我究竟是谁，又为何选择消失于世间。","vod_play_from":"lzm3u8","vod_play_server":"no","vod_play_note":"","vod_play_url":"HD中字$https:\/\/v.lfthirtytwo.com\/20260829\/9929_68816b46\/index.m3u8","vod_down_from":"http","vod_down_server":"no","vod_down_note":"","vod_down_url":"HD中字$https:\/\/dow.lzdown29.com\/20260829\/9929_68816b46\/她的秘密人生 Den Hemmelige Kvinde (2026).mp4","vod_plot":0,"vod_plot_name":"","vod_plot_detail":"","type_name":"剧情片"},{"vod_id":152448,"type_id":11,"type_id_1":1,"group_id":0,"vod_name":"抓特务","vod_sub":"无悔追踪 \/ I Know Who You Are","vod_en":"zhuatewu","vod_status":1,"vod_letter":"Z","vod_color":"","vod_tag":"","vod_class":"剧情","vod_pic":"https:\/\/img.lzipic.com\/upload\/vod\/20260817-1\/a567bc426146cfc818a6064a7088414c.webp","vod_pic_thumb":"","vod_pic_slide":"","vod_pic_screenshot":"","vod_actor":"雷佳音,胡歌,啜妮,张瑶,林晓凡,杨舒伊,刘佩琦,姜武,杨青,陈国星,于震,黄曼,张雪迎,梁洁,于和伟,甘昀宸,王锐,蔡家明,丁文博,王啸宇","vod_director":"冯小刚","vod_writer":"史建全","vod_behind":"","vod_blurb":"一场警察与特务的较量，却展开满是烟火与温情的百姓人生。                                                                      　　新","vod_remarks":"HD","vod_pubdate":"2026-06-19(中国大陆)","vod_total":0,"vod_serial":"","vod_tv":"","vod_weekday":"","vod_area":"中国大陆","vod_lang":"汉语普通话","vod_year":"2026","vod_version":"","vod_state":"","vod_author":"","vod_jumpurl":"","vod_tpl":"","vod_tpl_play":"","vod_tpl_down":"","vod_isend":0,"vod_lock":0,"vod_level":0,"vod_copyright":0,"vod_points":0,"vod_points_play":0,"vod_points_down":0,"vod_hits":0,"vod_hits_day":0,"vod_hits_week":0,"vod_hits_month":0,"vod_duration":"141分钟","vod_up":0,"vod_down":0,"vod_score":"7.4","vod_score_all":0,"vod_score_num":0,"vod_time":"2026-08-29 14:18:56","vod_time_add":1786951602,"vod